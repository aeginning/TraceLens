    <string name="help_title">Instrukcja</string>
    <string name="help_search_hint">Szukaj funkcji, np. mieszanie lub ostrość</string>
    <string name="help_no_results">Nie znaleziono pasującej funkcji.</string>
    <string name="help_screenshot">Zrzut ekranu aplikacji</string>
    <string name="help_tap_screenshot">Dotknij zrzutu, aby otworzyć go na pełnym ekranie.</string>
    <string name="help_enlarge_close">Powiększony zrzut. Dotknij, aby zamknąć.</string>
    <string name="help_chapter_start">Jak zacząć</string>
    <string name="help_chapter_library">Biblioteka</string>
    <string name="help_chapter_editor_patterns">Edytor i wzory</string>
    <string name="help_chapter_projects">Projekty</string>
    <string name="help_chapter_drawing">Rysowanie</string>
    <string name="help_chapter_progress">Postęp i publikacja</string>
    <string name="help_chapter_settings">Ustawienia</string>
    <string name="help_start_intro">Najprostszy przepływ pracy składa się z czterech kroków. Wszystkie dane pozostają lokalnie na telefonie.</string>
    <string name="help_start_1_title">1. Wybierz obraz</string>
    <string name="help_start_1_detail">Dodaj własny plik PNG/JPG albo wybierz jeden z gotowych wzorów offline.</string>
    <string name="help_start_2_title">2. Przygotuj projekt</string>
    <string name="help_start_2_detail">W razie potrzeby wykadruj i oczyść obraz, potem utwórz projekt i dopasuj nakładkę do kartki.</string>
    <string name="help_start_3_title">3. Rysuj</string>
    <string name="help_start_3_detail">Ustaw przezroczystość, zablokuj gesty i odrysowuj wzór, obserwując obraz z aparatu.</string>
    <string name="help_start_4_title">4. Zapisuj efekty</string>
    <string name="help_start_4_detail">Rób zdjęcia postępu, a na końcu utwórz timelapse, kolaż albo porównanie referencji z efektem.</string>
    <string name="help_library_intro">Biblioteka przechowuje przygotowane obrazy. Operacje dotyczą kopii w TraceLens, a nie oryginału w galerii telefonu.</string>
    <string name="help_search_title">Lupa — wyszukiwanie</string>
    <string name="help_search_detail">Rozwija pole wyszukiwania. Wpisz fragment własnej nazwy obrazu, aby szybko odnaleźć go w dużej bibliotece.</string>
    <string name="help_filters_title">Filtry i sortowanie</string>
    <string name="help_filters_detail">Pokazuje kolekcje, ulubione oraz sortowanie według nazwy lub daty dodania. Ponowne dotknięcie zwija panel.</string>
    <string name="help_favorite_title">Serce/gwiazdka — ulubione</string>
    <string name="help_favorite_detail">Oznacza często używany obraz. Filtr „Ulubione” pozwala później wyświetlić tylko takie pozycje.</string>
    <string name="help_rename_image_title">Ołówek z linią — zmiana nazwy</string>
    <string name="help_rename_image_detail">Nadaje czytelną nazwę wewnątrz TraceLens. Rozszerzenie i zawartość pliku nie są zmieniane.</string>
    <string name="help_edit_image_title">Ołówek — edycja obrazu</string>
    <string name="help_edit_image_detail">Otwiera edytor, w którym można kadrować, obracać, czyścić tło i stosować filtry.</string>
    <string name="help_project_image_title">Plus — nowy projekt z obrazu</string>
    <string name="help_project_image_detail">Tworzy projekt od razu z danego kafelka, bez ponownego wyszukiwania obrazu w selektorze.</string>
    <string name="help_collection_title">Folder — kolekcje</string>
    <string name="help_collection_detail">Przypisuje obraz do jednej lub kilku własnych kolekcji. Kolekcja porządkuje bibliotekę, ale nie duplikuje pliku.</string>
    <string name="help_delete_image_title">Kosz — usuń z biblioteki</string>
    <string name="help_delete_image_detail">Usuwa kopię obrazu z TraceLens po potwierdzeniu. Projekty korzystające z obrazu mogą ograniczyć możliwość usunięcia.</string>
    <string name="help_add_image_title">Duży plus — dodaj obraz</string>
    <string name="help_add_image_detail">Otwiera systemowy wybór pliku PNG lub JPG z pamięci telefonu. „Przeglądaj wzory” prowadzi do galerii offline.</string>
    <string name="help_editor_intro">Edytor przygotowuje wzór przed rysowaniem. Zapis tworzy przygotowaną wersję w bibliotece, a eksport dodatkowo umieszcza PNG w galerii telefonu.</string>
    <string name="help_crop_title">Kadrowanie i obrót</string>
    <string name="help_crop_detail">Kadrowanie wybiera potrzebny fragment obrazu. Obrót i prostowanie pomagają ustawić wzór pionowo przed zapisaniem.</string>
    <string name="help_remove_background_title">Usuwanie tła i gumka</string>
    <string name="help_remove_background_detail">Dotknij obrazu, aby wskazać kolor do usunięcia, a tolerancją określ podobieństwo kolorów. Gumka usuwa ręcznie pojedyncze fragmenty.</string>
    <string name="help_filters_editor_title">Filtry obrazu</string>
    <string name="help_filters_editor_detail">Skala szarości usuwa barwy, kontur tworzy linie, odwrócenie zamienia jasne z ciemnym, a uproszczenie ogranicza liczbę kolorów.</string>
    <string name="help_before_after_title">Przed/po</string>
    <string name="help_before_after_detail">Przytrzymaj ikonę porównania, aby chwilowo zobaczyć oryginał i ocenić, czy obróbka nie usunęła potrzebnych szczegółów.</string>
    <string name="help_export_editor_title">Eksportuj</string>
    <string name="help_export_editor_detail">Zapisuje aktualny efekt jako PNG w publicznej galerii telefonu. Komunikat potwierdza powodzenie albo opisuje błąd.</string>
    <string name="help_save_editor_title">Zapisz</string>
    <string name="help_save_editor_detail">Zapisuje przygotowany obraz w bibliotece TraceLens i wraca do listy obrazów.</string>
    <string name="help_patterns_title">Pakiet wzorów offline</string>
    <string name="help_patterns_detail">Galeria zawiera proste wzory dostępne bez internetu. Podgląd pokazuje nazwę, autora i rodzaj licencji.</string>
    <string name="help_pattern_actions_title">Dodaj wzór lub utwórz projekt</string>
    <string name="help_pattern_actions_detail">„Dodaj do biblioteki” zapisuje wzór do późniejszego użycia i blokuje niezmienione duplikaty. „Utwórz projekt” od razu rozpoczyna pracę.</string>
    <string name="help_projects_intro">Projekt zapamiętuje obraz, jego skalę i pozycję, aparat oraz ustawienia rysowania. Aktywne projekty można przenieść do archiwum bez utraty danych.</string>
    <string name="help_open_project_title">Trójkąt — otwórz lub wznów</string>
    <string name="help_open_project_detail">Uruchamia widok aparatu z ostatnio zapisanym położeniem nakładki. Duży przycisk wznawia ostatni aktywny projekt.</string>
    <string name="help_project_gallery_title">Galeria projektu</string>
    <string name="help_project_gallery_detail">Otwiera zdjęcia postępu. Ikona jest nieaktywna, dopóki projekt nie ma żadnego zdjęcia.</string>
    <string name="help_rename_project_title">Zmień nazwę projektu</string>
    <string name="help_rename_project_detail">Zmienia nazwę widoczną w aplikacji, folderach eksportu i brandingu materiałów społecznościowych.</string>
    <string name="help_archive_title">Pudełko ze strzałką w dół — archiwizuj</string>
    <string name="help_archive_detail">Przenosi zakończony lub chwilowo nieużywany projekt z listy Aktywne do zakładki Archiwum. Nie usuwa danych.</string>
    <string name="help_unarchive_title">Pudełko ze strzałką w górę — przywróć</string>
    <string name="help_unarchive_detail">Na karcie Archiwum przywraca projekt do aktywnej listy, aby można było ponownie go otworzyć i kontynuować.</string>
    <string name="help_export_project_title">Strzałka w dół — eksport projektu</string>
    <string name="help_export_project_detail">Tworzy przenośne archiwum projektu wraz z obrazem, ustawieniami i zdjęciami postępu.</string>
    <string name="help_import_project_title">Strzałka w górę — import projektu</string>
    <string name="help_import_project_detail">Wczytuje wcześniej wyeksportowane archiwum. Funkcja jest dostępna również wtedy, gdy lista projektów jest pusta.</string>
    <string name="help_transfer_title">Kod QR — przenieś lokalnie</string>
    <string name="help_transfer_detail">Uruchamia tymczasowy transfer w tej samej sieci Wi‑Fi. Zeskanuj kod drugim telefonem i nie zamykaj okna do zakończenia pobierania.</string>
    <string name="help_delete_project_title">Kosz — usuń projekt</string>
    <string name="help_delete_project_detail">Po potwierdzeniu usuwa projekt i jego prywatne dane. Materiały wcześniej wyeksportowane do galerii pozostają na telefonie.</string>
    <string name="help_drawing_intro">Nakładka leży nad obrazem z aparatu. Gdy gesty są odblokowane, przesuwaj ją jednym palcem, a dwoma skaluj i obracaj.</string>
    <string name="help_photo_title">Aparat — zdjęcie postępu</string>
    <string name="help_photo_detail">Robi zdjęcie samego widoku aparatu i zapisuje je w projekcie oraz galerii telefonu. Nakładka nie jest wypalana na zdjęciu.</string>
    <string name="help_hide_overlay_title">Przekreślone oko — ukryj nakładkę</string>
    <string name="help_hide_overlay_detail">Przytrzymaj, aby chwilowo zobaczyć samą pracę. Po puszczeniu palca wzór wraca z dotychczasową przezroczystością.</string>
    <string name="help_controls_title">Suwaki — pokaż sterowanie</string>
    <string name="help_controls_detail">Otwiera panel zaawansowanych ustawień. Zamknięcie panelu nie zmienia kadru kamery ani położenia nakładki.</string>
    <string name="help_gesture_lock_title">Kłódka — blokada gestów</string>
    <string name="help_gesture_lock_detail">Blokuje przesuwanie, skalowanie i obracanie nakładki, aby przypadkowe dotknięcie nie zepsuło jej ustawienia. Dolne przyciski nadal działają.</string>
    <string name="help_grid_title">Siatka</string>
    <string name="help_grid_detail">Pomaga przenosić proporcje fragment po fragmencie. Można zmienić liczbę pól i przezroczystość; kolor wybiera się w Ustawieniach.</string>
    <string name="help_sections_title">Fragmenty pracy</string>
    <string name="help_sections_detail">Dzieli ekran na sekcje i przyciemnia nieaktywny obszar. Strzałkami przechodzisz kolejno przez fragmenty dużego rysunku.</string>
    <string name="help_flip_title">Odbij X / Odbij Y</string>
    <string name="help_flip_detail">Tworzy lustrzane odbicie wzoru w poziomie albo pionie. Przydatne przy kalkowaniu na odwrocie i wzorach symetrycznych.</string>
    <string name="help_camera_lock_title">Zablokuj kamerę</string>
    <string name="help_camera_lock_detail">Zapamiętuje bieżącą ostrość, ekspozycję i balans bieli, aby aparat nie „pompował” obrazu podczas rysowania. To inna funkcja niż kłódka gestów.</string>
    <string name="help_manual_focus_title">Ręczna ostrość</string>
    <string name="help_manual_focus_detail">Gdy nakładka jest zablokowana, dotknij miejsca na podglądzie, które ma być ostre. Aparat ustawi tam punkt pomiaru; potem możesz zablokować kamerę.</string>
    <string name="help_torch_title">Latarka</string>
    <string name="help_torch_detail">Włącza diodę aparatu do oświetlenia kartki. Długie używanie zwiększa temperaturę i zużycie baterii.</string>
    <string name="help_blink_title">Miganie</string>
    <string name="help_blink_detail">Cyklicznie pokazuje i ukrywa nakładkę, ułatwiając porównanie wzoru z rysunkiem. Suwak ustala tempo migania.</string>
    <string name="help_timelapse_title">Timelapse</string>
    <string name="help_timelapse_detail">Automatycznie wykonuje zdjęcia postępu w wybranym odstępie. Z tych klatek można później wygenerować pionowy film MP4.</string>
    <string name="help_tripod_title">Zapisz statyw</string>
    <string name="help_tripod_detail">Zapisuje zdjęcie kontrolne ustawienia telefonu. Po poruszeniu statywu półprzezroczysta referencja pomaga wrócić do poprzedniego kadru.</string>
    <string name="help_blending_title">Tryb mieszania</string>
    <string name="help_blending_detail">Zwykłe pokazuje obraz bez specjalnego łączenia. Mnożenie przyciemnia nakładkę względem kamery i dobrze eksponuje linie. Ekran rozjaśnia jasne fragmenty; wybierz tryb czytelny dla danego tła.</string>
    <string name="help_progress_intro">Galeria porządkuje zdjęcia chronologicznie. Z zapisanych etapów można przygotować gotowy materiał bez wysyłania danych na serwer TraceLens.</string>
    <string name="help_open_photo_title">Otwórz i przesuwaj zdjęcia</string>
    <string name="help_open_photo_detail">Dotknij miniatury, aby zobaczyć pełny ekran. Przesuwaj palcem między zdjęciami, powiększaj albo otwórz plik w galerii telefonu.</string>
    <string name="help_share_gallery_title">Udostępnij galerię</string>
    <string name="help_share_gallery_detail">Przekazuje wybrane zdjęcia do systemowego arkusza udostępniania Androida.</string>
    <string name="help_movie_title">Timelapse MP4</string>
    <string name="help_movie_detail">Łączy zdjęcia chronologicznie w pionowy film. Ustaw czas pojedynczej klatki; materiał otrzyma branding TraceLens i nazwę projektu.</string>
    <string name="help_collage_title">Kolaż postępu</string>
    <string name="help_collage_detail">Połącz 2, 4, 6 lub 8 wybranych etapów. Dostępne układy zależą od liczby zdjęć, a numery zaznaczeń ustalają kolejność.</string>
    <string name="help_reference_title">Referencja i efekt</string>
    <string name="help_reference_detail">Zestawia przygotowany wzór z wybranym zdjęciem pracy. Możesz wybrać format posta 4:5 albo pionowy format relacji 9:16.</string>
    <string name="help_social_title">Instagram, TikTok i udostępnianie</string>
    <string name="help_social_detail">Materiał jest najpierw zapisywany w galerii. Przycisk otwiera wybraną aplikację lub arkusz Androida; TraceLens nigdy nie publikuje automatycznie.</string>
    <string name="help_delete_photo_title">Usuń zdjęcie postępu</string>
    <string name="help_delete_photo_detail">Usuwa wybrane zdjęcie z projektu po potwierdzeniu. Wyeksportowany wcześniej materiał pozostaje w galerii telefonu.</string>
    <string name="help_settings_intro">Ustawienia określają wartości startowe nowych projektów oraz wygląd aplikacji. Zmiana domyślnej wartości nie nadpisuje istniejących projektów.</string>
    <string name="help_defaults_title">Domyślne ustawienia projektów</string>
    <string name="help_defaults_detail">Ustal początkową przezroczystość, siatkę, miganie, timelapse, latarkę i obiektyw dla każdego nowego projektu.</string>
    <string name="help_grid_color_title">Kolor siatki</string>
    <string name="help_grid_color_detail">Wybierz kolor kontrastujący z kartką i wzorem. Ustawienie będzie używane we wszystkich projektach.</string>
    <string name="help_language_title">Język i wygląd</string>
    <string name="help_language_detail">Wybierz polski, angielski albo język systemowy oraz jasny, ciemny lub systemowy motyw aplikacji.</string>
    <string name="help_indicators_title">Informacje na ekranie</string>
    <string name="help_indicators_detail">Włącz lub ukryj poziomicę, ostrzeżenie o poruszeniu telefonu oraz monitor baterii i temperatury.</string>
    <string name="help_storage_title">Pamięć aplikacji</string>
    <string name="help_storage_detail">Pokazuje miejsce zajęte przez obrazy, projekty i zdjęcia. Narzędzia porządkowania usuwają tylko elementy wskazane w komunikacie.</string>
</resources>
