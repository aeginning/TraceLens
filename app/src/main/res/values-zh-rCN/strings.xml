    <string name="help_title">使用指南</string>
    <string name="help_search_hint">搜索功能，例如：混合模式或对焦</string>
    <string name="help_no_results">未找到匹配的功能。</string>
    <string name="help_screenshot">应用截图</string>
    <string name="help_tap_screenshot">点击截图可全屏查看。</string>
    <string name="help_enlarge_close">截图已放大。点击关闭。</string>
    <string name="help_chapter_start">入门</string>
    <string name="help_chapter_library">图像库</string>
    <string name="help_chapter_editor_patterns">编辑器与图案</string>
    <string name="help_chapter_projects">项目</string>
    <string name="help_chapter_drawing">绘画</string>
    <string name="help_chapter_progress">进度与分享</string>
    <string name="help_chapter_settings">设置</string>
    <string name="help_start_intro">基本工作流程分为四个步骤。所有数据都保存在手机本地。</string>
    <string name="help_start_1_title">1. 选择图像</string>
    <string name="help_start_1_detail">添加自己的 PNG/JPG 文件，或选择应用内置的离线图案。</string>
    <string name="help_start_2_title">2. 准备项目</string>
    <string name="help_start_2_detail">按需裁剪和清理图像，创建项目，并将叠加图像与纸面位置对齐。</string>
    <string name="help_start_3_title">3. 开始绘画</string>
    <string name="help_start_3_detail">设置不透明度、锁定手势，并观察摄像头预览描摹图案。</string>
    <string name="help_start_4_title">4. 保存成果</string>
    <string name="help_start_4_detail">拍摄进度照片，然后创建延时摄影、拼图，或参考图与成果图对比。</string>
    <string name="help_library_intro">图像库用于保存已处理的图像。操作只会影响 TraceLens 中的副本，不会修改手机图库中的原图。</string>
    <string name="help_search_title">放大镜 — 搜索</string>
    <string name="help_search_detail">展开搜索栏。输入自定义图像名称的一部分，即可在大型图像库中快速找到目标。</string>
    <string name="help_filters_title">筛选与排序</string>
    <string name="help_filters_detail">显示分类、收藏，以及按名称或添加日期排序的选项。再次点击可收起面板。</string>
    <string name="help_favorite_title">爱心／星形 — 收藏</string>
    <string name="help_favorite_detail">标记常用图像。之后使用“收藏”筛选器即可只显示已标记的项目。</string>
    <string name="help_rename_image_title">带横线的铅笔 — 重命名</string>
    <string name="help_rename_image_detail">设置图像在 TraceLens 中显示的名称。文件扩展名和图像内容不会改变。</string>
    <string name="help_edit_image_title">铅笔 — 编辑图像</string>
    <string name="help_edit_image_detail">打开编辑器，以便裁剪、旋转、清理背景和应用滤镜。</string>
    <string name="help_project_image_title">加号 — 根据图像创建项目</string>
    <string name="help_project_image_detail">无需在选择器中再次查找图像，即可直接从此缩略图创建项目。</string>
    <string name="help_collection_title">文件夹 — 分类</string>
    <string name="help_collection_detail">将图像分配到一个或多个自定义分类。分类可以整理图像库，而不会复制文件。</string>
    <string name="help_delete_image_title">垃圾桶 — 从图像库移除</string>
    <string name="help_delete_image_detail">确认后移除 TraceLens 中的副本。正在被项目使用的图像可能受到删除保护。</string>
    <string name="help_add_image_title">大号加号 — 添加图像</string>
    <string name="help_add_image_detail">打开系统 PNG/JPG 文件选择器。“浏览图案”会打开内置离线图库。</string>
    <string name="help_editor_intro">编辑器用于在绘画前准备图案。保存会在图像库中创建处理后的版本；导出还会将 PNG 保存到手机图库。</string>
    <string name="help_crop_title">裁剪与旋转</string>
    <string name="help_crop_detail">裁剪用于选择所需区域。保存之前，可通过旋转和校正调整图案方向。</string>
    <string name="help_remove_background_title">移除背景与橡皮擦</string>
    <string name="help_remove_background_detail">点击图像选取一种颜色，然后设置要移除颜色的相似程度。橡皮擦可手动清除指定区域。</string>
    <string name="help_filters_editor_title">图像滤镜</string>
    <string name="help_filters_editor_detail">灰度移除颜色；轮廓生成线条；反转交换明暗；简化则减少颜色数量。</string>
    <string name="help_before_after_title">处理前／处理后</string>
    <string name="help_before_after_detail">按住对比图标查看原图，确认处理过程没有移除重要细节。</string>
    <string name="help_export_editor_title">导出</string>
    <string name="help_export_editor_detail">将当前结果保存为 PNG 到手机公共图库。应用会提示成功，或说明发生的错误。</string>
    <string name="help_save_editor_title">保存</string>
    <string name="help_save_editor_detail">将处理后的图像保存到 TraceLens 图像库，然后返回图像列表。</string>
    <string name="help_patterns_title">离线图案包</string>
    <string name="help_patterns_detail">图库包含无需联网即可使用的简单图案。预览会显示标题、作者和许可类型。</string>
    <string name="help_pattern_actions_title">添加图案或创建项目</string>
    <string name="help_pattern_actions_detail">“添加到图像库”可保存图案供以后使用，并阻止重复添加相同图案。“创建项目”则立即开始使用。</string>
    <string name="help_projects_intro">项目会记住图像、缩放比例、位置、摄像头和绘画设置。进行中的项目可以归档，不会丢失数据。</string>
    <string name="help_open_project_title">三角形 — 打开或继续</string>
    <string name="help_open_project_detail">使用上次保存的叠加图像位置启动摄像头。大按钮可继续最近一个进行中的项目。</string>
    <string name="help_project_gallery_title">项目图库</string>
    <string name="help_project_gallery_detail">打开进度照片。项目至少有一张照片后，此图标才会启用。</string>
    <string name="help_rename_project_title">重命名项目</string>
    <string name="help_rename_project_detail">更改应用、导出文件夹以及生成的社交媒体素材中使用的项目名称。</string>
    <string name="help_archive_title">带向下箭头的方框 — 归档</string>
    <string name="help_archive_detail">将已完成或暂停的项目从“进行中”移至“归档”，不会删除任何数据。</string>
    <string name="help_unarchive_title">带向上箭头的方框 — 恢复</string>
    <string name="help_unarchive_detail">在“归档”标签页中，将项目恢复到“进行中”，以便打开并继续操作。</string>
    <string name="help_export_project_title">向下箭头 — 导出项目</string>
    <string name="help_export_project_detail">创建可移植的归档文件，其中包含图像、设置和进度照片。</string>
    <string name="help_import_project_title">向上箭头 — 导入项目</string>
    <string name="help_import_project_detail">加载之前导出的归档文件。即使项目列表为空，也可以使用导入功能。</string>
    <string name="help_transfer_title">二维码 — 本地传输</string>
    <string name="help_transfer_detail">在同一 Wi-Fi 网络中启动临时传输。使用另一部手机扫描二维码，并保持对话框打开，直到下载完成。</string>
    <string name="help_delete_project_title">垃圾桶 — 删除项目</string>
    <string name="help_delete_project_detail">确认后删除项目及其私有数据。已经导出到图库的媒体文件仍会保留在手机中。</string>
    <string name="help_drawing_intro">叠加图像位于摄像头画面上方。解锁手势后，可用单指拖动，并用双指缩放和旋转。</string>
    <string name="help_photo_title">摄像头 — 进度照片</string>
    <string name="help_photo_detail">拍摄干净的摄像头画面，并保存到项目和手机图库。叠加图像不会被合成到照片中。</string>
    <string name="help_hide_overlay_title">划线的眼睛 — 隐藏叠加图像</string>
    <string name="help_hide_overlay_detail">按住只查看自己的绘画。松开后，图案会以当前不透明度重新显示。</string>
    <string name="help_controls_title">滑块 — 显示控制项</string>
    <string name="help_controls_detail">打开高级设置。关闭面板不会改变摄像头取景或叠加图像的位置。</string>
    <string name="help_gesture_lock_title">挂锁 — 手势锁定</string>
    <string name="help_gesture_lock_detail">防止叠加图像意外移动、缩放或旋转。底部操作按钮仍可使用。</string>
    <string name="help_grid_title">网格</string>
    <string name="help_grid_detail">帮助你逐个区域转移图像比例。可以设置网格分割数和不透明度，并在设置中选择颜色。</string>
    <string name="help_sections_title">绘画分区</string>
    <string name="help_sections_detail">将画面划分为多个区域，并调暗非活动区域。使用箭头在大型绘画的各个分区之间移动。</string>
    <string name="help_flip_title">水平翻转／垂直翻转</string>
    <string name="help_flip_detail">水平或垂直镜像图案。适用于反面描摹和对称设计。</string>
    <string name="help_camera_lock_title">锁定摄像头</string>
    <string name="help_camera_lock_detail">保持当前焦点、曝光和白平衡，避免绘画过程中摄像头反复调整。这与手势锁定不同。</string>
    <string name="help_manual_focus_title">手动对焦</string>
    <string name="help_manual_focus_detail">锁定叠加图像后，点击摄像头画面中需要清晰显示的区域。摄像头会在该处测光，然后你可以锁定摄像头参数。</string>
    <string name="help_torch_title">手电筒</string>
    <string name="help_torch_detail">开启摄像头 LED，为纸面照明。长时间使用会增加手机温度和电池消耗。</string>
    <string name="help_blink_title">闪烁</string>
    <string name="help_blink_detail">定期隐藏和显示叠加图像，以便比较图案与绘画。滑块用于控制闪烁间隔。</string>
    <string name="help_timelapse_title">延时摄影</string>
    <string name="help_timelapse_detail">按选定的时间间隔自动拍摄进度照片。之后可以将这些画面制作成竖屏 MP4 视频。</string>
    <string name="help_tripod_title">保存三脚架位置</string>
    <string name="help_tripod_detail">保存当前设备摆放的参考照片。如果支架发生移动，半透明参考图可帮助恢复之前的取景位置。</string>
    <string name="help_blending_title">混合模式</string>
    <string name="help_blending_detail">正常模式直接显示图像。正片叠底会使图像相对摄像头画面变暗并突出线条。滤色会提亮浅色区域；请选择最适合当前纸面的模式。</string>
    <string name="help_progress_intro">图库按时间顺序排列照片。保存的阶段可以制作成可分享的媒体，无需将数据上传到 TraceLens 服务器。</string>
    <string name="help_open_photo_title">打开和滑动浏览照片</string>
    <string name="help_open_photo_detail">点击缩略图可全屏查看。可以在照片之间滑动、缩放，或在手机图库中打开文件。</string>
    <string name="help_share_gallery_title">分享图库</string>
    <string name="help_share_gallery_detail">通过 Android 系统分享面板发送选定的照片。</string>
    <string name="help_movie_title">MP4 延时摄影</string>
    <string name="help_movie_detail">按时间顺序将照片合成为竖屏视频。设置每帧时长后，应用会自动添加品牌标识和项目名称。</string>
    <string name="help_collage_title">进度拼图</string>
    <string name="help_collage_detail">合并 2、4、6 或 8 个阶段。可用布局取决于照片数量，选择编号决定排列顺序。</string>
    <string name="help_reference_title">参考图与成果图</string>
    <string name="help_reference_detail">将处理后的图案与选定的成果照片并排显示。可以选择 4:5 信息流格式或 9:16 竖屏快拍格式。</string>
    <string name="help_social_title">Instagram、TikTok 与分享</string>
    <string name="help_social_detail">媒体会先保存到图库。按钮只会打开应用或 Android 分享面板；TraceLens 不会自动发布内容。</string>
    <string name="help_delete_photo_title">删除进度照片</string>
    <string name="help_delete_photo_detail">确认后移除所选项目照片。之前导出的媒体仍会保留在手机图库中。</string>
    <string name="help_settings_intro">设置用于定义新项目的默认值和应用外观。更改默认值不会覆盖现有项目。</string>
    <string name="help_defaults_title">项目默认设置</string>
    <string name="help_defaults_detail">为每个新项目设置初始不透明度、网格、闪烁、延时摄影、手电筒和镜头。</string>
    <string name="help_grid_color_title">网格颜色</string>
    <string name="help_grid_color_detail">选择一种与纸张和图案形成对比的颜色。该颜色会用于所有项目。</string>
    <string name="help_language_title">语言与外观</string>
    <string name="help_language_detail">选择波兰语、英语、简体中文或系统语言，以及浅色、深色或系统主题。</string>
    <string name="help_indicators_title">屏幕信息</string>
    <string name="help_indicators_detail">显示或隐藏水平仪、手机移动警告以及电量／温度监视器。</string>
    <string name="help_storage_title">应用存储</string>
    <string name="help_storage_detail">显示图像、项目和照片占用的空间。清理工具只会移除确认提示中明确列出的项目。</string>
</resources>
