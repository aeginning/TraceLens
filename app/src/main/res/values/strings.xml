    <string name="help_start_intro">The basic workflow has four steps. All your data stays locally on your phone.</string>
    <string name="help_start_1_title">1. Choose an image</string>
    <string name="help_start_1_detail">Add your own PNG/JPG file or choose one of the included offline patterns.</string>
    <string name="help_start_2_title">2. Prepare a project</string>
    <string name="help_start_2_detail">Crop and clean the image if needed, create a project, and align the overlay with your paper.</string>
    <string name="help_start_3_title">3. Draw</string>
    <string name="help_start_3_detail">Set opacity, lock gestures, and trace the pattern while watching the camera preview.</string>
    <string name="help_start_4_title">4. Save your results</string>
    <string name="help_start_4_detail">Take progress photos, then create a timelapse, collage, or reference-versus-result comparison.</string>
    <string name="help_library_intro">The library stores prepared images. Actions affect the TraceLens copy, not the original in your phone gallery.</string>
    <string name="help_search_title">Magnifier — search</string>
    <string name="help_search_detail">Expands the search field. Enter part of your custom image name to find it quickly in a large library.</string>
    <string name="help_filters_title">Filters and sorting</string>
    <string name="help_filters_detail">Shows collections, favorites, and sorting by name or date added. Tap again to collapse the panel.</string>
    <string name="help_favorite_title">Heart/star — favorites</string>
    <string name="help_favorite_detail">Marks a frequently used image. The Favorites filter later shows only marked items.</string>
    <string name="help_rename_image_title">Pencil with line — rename</string>
    <string name="help_rename_image_detail">Sets a readable name inside TraceLens. The file extension and image contents do not change.</string>
    <string name="help_edit_image_title">Pencil — edit image</string>
    <string name="help_edit_image_detail">Opens the editor for cropping, rotation, background cleanup, and filters.</string>
    <string name="help_project_image_title">Plus — project from image</string>
    <string name="help_project_image_detail">Creates a project directly from this tile without finding the image again in the selector.</string>
    <string name="help_collection_title">Folder — collections</string>
    <string name="help_collection_detail">Assigns an image to one or more custom collections. A collection organizes the library without duplicating files.</string>
    <string name="help_delete_image_title">Bin — remove from library</string>
    <string name="help_delete_image_detail">Removes the TraceLens copy after confirmation. Images used by projects may be protected from deletion.</string>
    <string name="help_add_image_title">Large plus — add image</string>
    <string name="help_add_image_detail">Opens the system PNG/JPG picker. Browse patterns opens the built-in offline gallery.</string>
    <string name="help_editor_intro">The editor prepares a pattern before drawing. Save creates a prepared library version; Export also places a PNG in the phone gallery.</string>
    <string name="help_crop_title">Crop and rotate</string>
    <string name="help_crop_detail">Cropping selects the required area. Rotation and straightening align the pattern before it is saved.</string>
    <string name="help_remove_background_title">Background removal and eraser</string>
    <string name="help_remove_background_detail">Tap the image to pick a color, then set how similar removed colors may be. The eraser removes individual areas manually.</string>
    <string name="help_filters_editor_title">Image filters</string>
    <string name="help_filters_editor_detail">Grayscale removes color, Outline creates lines, Invert swaps light and dark, and Simplify reduces the color count.</string>
    <string name="help_before_after_title">Before/after</string>
    <string name="help_before_after_detail">Hold the comparison icon to view the original and check that processing did not remove important details.</string>
    <string name="help_export_editor_title">Export</string>
    <string name="help_export_editor_detail">Saves the current result as a PNG in the public phone gallery. A message confirms success or explains an error.</string>
    <string name="help_save_editor_title">Save</string>
    <string name="help_save_editor_detail">Saves the prepared image in the TraceLens library and returns to the image list.</string>
    <string name="help_patterns_title">Offline pattern pack</string>
    <string name="help_patterns_detail">The gallery contains simple patterns available without internet. Preview shows the title, author, and license type.</string>
    <string name="help_pattern_actions_title">Add pattern or create project</string>
    <string name="help_pattern_actions_detail">Add to library stores the pattern for later and blocks unchanged duplicates. Create project starts work immediately.</string>
    <string name="help_projects_intro">A project remembers its image, scale, position, camera, and drawing settings. Active projects can be archived without data loss.</string>
    <string name="help_open_project_title">Triangle — open or resume</string>
    <string name="help_open_project_detail">Starts the camera with the last saved overlay position. The large button resumes the most recent active project.</string>
    <string name="help_project_gallery_title">Project gallery</string>
    <string name="help_project_gallery_detail">Opens progress photos. The icon stays disabled until the project has at least one photo.</string>
    <string name="help_rename_project_title">Rename project</string>
    <string name="help_rename_project_detail">Changes the name used in the app, export folders, and branding on generated social media materials.</string>
    <string name="help_archive_title">Box with down arrow — archive</string>
    <string name="help_archive_detail">Moves a finished or paused project from Active to Archive without deleting any data.</string>
    <string name="help_unarchive_title">Box with up arrow — restore</string>
    <string name="help_unarchive_detail">On the Archive tab, returns a project to Active so it can be opened and continued.</string>
    <string name="help_export_project_title">Down arrow — export project</string>
    <string name="help_export_project_detail">Creates a portable archive containing the image, settings, and progress photos.</string>
    <string name="help_import_project_title">Up arrow — import project</string>
    <string name="help_import_project_detail">Loads a previously exported archive. Import remains available even when the project list is empty.</string>
    <string name="help_transfer_title">QR code — local transfer</string>
    <string name="help_transfer_detail">Starts a temporary transfer on the same Wi‑Fi network. Scan it with the second phone and keep the dialog open until download completes.</string>
    <string name="help_delete_project_title">Bin — delete project</string>
    <string name="help_delete_project_detail">Deletes the project and its private data after confirmation. Media already exported to the gallery remains on the phone.</string>
    <string name="help_drawing_intro">The overlay sits above the camera view. When gestures are unlocked, drag with one finger and use two fingers to scale and rotate.</string>
    <string name="help_photo_title">Camera — progress photo</string>
    <string name="help_photo_detail">Captures the clean camera view and saves it in the project and phone gallery. The overlay is not burned into the photo.</string>
    <string name="help_hide_overlay_title">Crossed eye — hide overlay</string>
    <string name="help_hide_overlay_detail">Hold to see only your work. Releasing restores the pattern at its current opacity.</string>
    <string name="help_controls_title">Sliders — show controls</string>
    <string name="help_controls_detail">Opens advanced settings. Closing the panel does not change the camera framing or overlay position.</string>
    <string name="help_gesture_lock_title">Padlock — gesture lock</string>
    <string name="help_gesture_lock_detail">Prevents accidental overlay movement, scaling, and rotation. The bottom action buttons continue to work.</string>
    <string name="help_grid_title">Grid</string>
    <string name="help_grid_detail">Helps transfer proportions one area at a time. Set its divisions and opacity; choose the color in Settings.</string>
    <string name="help_sections_title">Work sections</string>
    <string name="help_sections_detail">Divides the view and dims inactive areas. Use arrows to move through sections of a large drawing.</string>
    <string name="help_flip_title">Flip X / Flip Y</string>
    <string name="help_flip_detail">Mirrors the pattern horizontally or vertically. Useful for tracing on the reverse side and for symmetric designs.</string>
    <string name="help_camera_lock_title">Lock camera</string>
    <string name="help_camera_lock_detail">Keeps the current focus, exposure, and white balance so the camera does not hunt while drawing. This differs from gesture lock.</string>
    <string name="help_manual_focus_title">Manual focus</string>
    <string name="help_manual_focus_detail">With the overlay locked, tap the camera area that should be sharp. The camera meters there; you can then lock camera parameters.</string>
    <string name="help_torch_title">Torch</string>
    <string name="help_torch_detail">Turns on the camera LED to illuminate the paper. Long use increases temperature and battery drain.</string>
    <string name="help_blink_title">Blinking</string>
    <string name="help_blink_detail">Periodically hides and shows the overlay to compare pattern and drawing. The slider controls the interval.</string>
    <string name="help_timelapse_title">Timelapse</string>
    <string name="help_timelapse_detail">Automatically takes progress photos at the selected interval. These frames can later become a vertical MP4.</string>
    <string name="help_tripod_title">Save tripod position</string>
    <string name="help_tripod_detail">Stores a reference photo of the setup. If the stand moves, the translucent reference helps restore the previous framing.</string>
    <string name="help_blending_title">Blend mode</string>
    <string name="help_blending_detail">Normal shows the image directly. Multiply darkens it against the camera and emphasizes lines. Screen brightens light areas; choose the clearest mode for the surface.</string>
    <string name="help_progress_intro">The gallery sorts photos chronologically. Saved stages can become shareable media without uploading data to TraceLens servers.</string>
    <string name="help_open_photo_title">Open and swipe photos</string>
    <string name="help_open_photo_detail">Tap a thumbnail for full screen. Swipe between photos, zoom, or open the file in the phone gallery.</string>
    <string name="help_share_gallery_title">Share gallery</string>
    <string name="help_share_gallery_detail">Sends selected photos to the Android system share sheet.</string>
    <string name="help_movie_title">MP4 timelapse</string>
    <string name="help_movie_detail">Combines photos chronologically into a vertical video. Set frame duration; branding and project name are added automatically.</string>
    <string name="help_collage_title">Progress collage</string>
    <string name="help_collage_detail">Combine 2, 4, 6, or 8 stages. Available layouts depend on photo count, and selection numbers define order.</string>
    <string name="help_reference_title">Reference and result</string>
    <string name="help_reference_detail">Places the prepared pattern beside a selected result photo. Choose a 4:5 feed format or vertical 9:16 story format.</string>
    <string name="help_social_title">Instagram, TikTok, and sharing</string>
    <string name="help_social_detail">Media is saved to the gallery first. Buttons open an app or Android share sheet; TraceLens never publishes automatically.</string>
    <string name="help_delete_photo_title">Delete progress photo</string>
    <string name="help_delete_photo_detail">Removes the selected project photo after confirmation. Previously exported media remains in the phone gallery.</string>
    <string name="help_settings_intro">Settings define defaults for new projects and the app appearance. Changing a default does not overwrite existing projects.</string>
    <string name="help_defaults_title">Default project settings</string>
    <string name="help_defaults_detail">Set initial opacity, grid, blinking, timelapse, torch, and lens for every new project.</string>
    <string name="help_grid_color_title">Grid color</string>
    <string name="help_grid_color_detail">Choose a color that contrasts with the paper and pattern. It is used across all projects.</string>
    <string name="help_language_title">Language and appearance</string>
    <string name="help_language_detail">Choose Polish, English, or system language, plus light, dark, or system theme.</string>
    <string name="help_indicators_title">On-screen information</string>
    <string name="help_indicators_detail">Show or hide the level, moved-phone warning, and battery/temperature monitor.</string>
    <string name="help_storage_title">App storage</string>
    <string name="help_storage_detail">Shows space used by images, projects, and photos. Cleanup tools remove only the items named in their confirmation message.</string>
</resources>
